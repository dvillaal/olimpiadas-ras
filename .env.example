# ─── Supabase ────────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Clave de servicio. NUNCA se expone al navegador: solo se usa en el servidor
# para crear usuarios y aprobar grupos.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ─── Correo transaccional (Resend) ───────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Remitente verificado en tu dominio de Resend.
EMAIL_FROM="Olimpiadas Scouts <olimpiadas@tudominio.org>"
# Copia de las notificaciones administrativas (solicitudes de registro, pagos).
EMAIL_ADMIN="admin@tudominio.org"

# ─── Aplicación ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Playground / proyecto de pruebas (opcional) ─────────────────────────────
# ¿Tienes un segundo proyecto de Supabase solo para hacer pruebas? Copia estas
# mismas variables a un archivo `.env.development.local` (no a este) con los
# datos de ESE proyecto. Next.js lo prefiere automáticamente sobre `.env.local`
# al correr `npm run dev`, así que el desarrollo local queda apuntando al
# playground sin tocar `.env.local` (que se queda con los datos reales).
# `npm run seed:admin` y `npm run reset:testing:auth` también lo respetan.
