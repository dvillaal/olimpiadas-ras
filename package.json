{
  "name": "olimpiadas-scouts",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión de las Olimpiadas Scouts: grupos, participantes, países, deportes, equipos intergrupales, pagos y stands.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "next build",
    "db:link": "supabase link",
    "db:push": "supabase db push --linked",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db push --linked --include-seed",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts",
    "db:validate": "node scripts/validate-sql.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "reset:testing:auth": "node scripts/reset-testing-auth.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "exceljs": "4.3.0",
    "next": "^16.3.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.18.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.0",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
